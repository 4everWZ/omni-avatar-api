# 首次启动前复制为 .env，填写各自独立的随机凭据。
OMNI_GATEWAY_TOKEN=
OMNI_GATEWAY_ADMIN_TOKEN=
# 其它应用可使用独立凭据，格式为 JSON 对象，例 {"other-app":"<token>"}。
OMNI_GATEWAY_TOKENS=
OMNI_MODEL_DATA=./data/models
TUBER_OMNI_NETWORK=tuber-omni

# 默认只在宿主回环发布；同 Docker 网络应用可使用服务名直连。
OMNI_GATEWAY_BIND=127.0.0.1
OMNI_GATEWAY_PORT=8000
# Optional deploy/compose/vpn.yml: publish to the private VPN address as well.
OMNI_GATEWAY_VPN_BIND=
OMNI_BATCH_CAP=1
OMNI_LIVE_CAP=1
OMNI_WORKSTATION_CAP=2
OMNI_QUEUE_TIMEOUT=5
OMNI_REQUEST_TIMEOUT=1200
OMNI_HEALTH_TIMEOUT=3
OMNI_REALTIME_IDLE_TIMEOUT=120

# Optional LLM-only admission/deadline overrides for external orchestrators.
# Empty values inherit the corresponding Omni gateway values.
LLM_QUEUE_LIMIT=
LLM_QUEUE_TIMEOUT=
LLM_REQUEST_TIMEOUT=
# Real engine sequences and gateway capacity; total rendered input + max output.
# Device selectors for the split workstation profile (index or UUID).
OMNI_GPU_DEVICE=1
LLM_GPU_DEVICE=0
LLM_MAX_NUM_SEQS=4
LLM_MAX_NUM_BATCHED_TOKENS=2048
LLM_TOKEN_BUDGET=262144
# Neural-portrait overlay: CUDA MPS client execution-resource limit.
# Requalify throughput and portrait timing before changing this percentage.
LLM_MPS_ACTIVE_THREAD_PERCENTAGE=20

# Avatar overlay. Internal bearer differs from every application/admin token.
OMNI_AVATAR_INTERNAL_TOKEN=
# Portrait frame execution. The shared Dockerfile builds the selected runtime before copying source.
OMNI_PORTRAIT_FRAME_BACKEND=cuda-graph
OMNI_PORTRAIT_CAP=1
OMNI_PORTRAIT_IMAGE=omni-api-portrait:ditto
OMNI_PORTRAIT_DOCKERFILE=Dockerfile

# Optional --images layer. Use separate private credentials.
OMNI_IMAGE_INTERNAL_TOKEN=
LLM_GPU_CONTROL_TOKEN=
OMNI_IMAGE_MIN_FREE_MIB=13312

# Optional deploy/compose/media.yml. Set independent publishing/reading passwords.
MEDIAMTX_PUBLISH_PASSWORD=
MEDIAMTX_READ_PASSWORD=
MEDIAMTX_SIGNAL_BIND=127.0.0.1
MEDIAMTX_SIGNAL_PORT=8889
MEDIAMTX_ICE_BIND=127.0.0.1
MEDIAMTX_ICE_HOST=127.0.0.1
