# 首次启动前复制为 .env，填写各自独立的随机凭据。
OMNI_GATEWAY_TOKEN=
OMNI_GATEWAY_ADMIN_TOKEN=
# 其它应用可使用独立凭据，格式为 JSON 对象，例 {"other-app":"<token>"}。
OMNI_GATEWAY_TOKENS=
# Required for default workstation (omni-asr + omni-tts) and --asr on legacy/gateway targets.
OMNI_ASR_INTERNAL_TOKEN=
OMNI_TTS_INTERNAL_TOKEN=
OMNI_MODEL_DATA=./data/models
TUBER_OMNI_NETWORK=tuber-omni

# 默认只在宿主回环发布；同 Docker 网络应用可使用服务名直连。
OMNI_GATEWAY_BIND=127.0.0.1
OMNI_GATEWAY_PORT=8000
# Optional deploy/compose/vpn.yml: publish to the private VPN address as well.
OMNI_GATEWAY_VPN_BIND=
OMNI_BATCH_CAP=1
OMNI_LIVE_CAP=1
OMNI_QUEUE_TIMEOUT=5
OMNI_REQUEST_TIMEOUT=1200
OMNI_HEALTH_TIMEOUT=3
OMNI_REALTIME_IDLE_TIMEOUT=120

# --- Personal-Agent-First Dual-3090 workstation defaults (--target workstation) ---
# Physical GPU device selectors (index or UUID).
# TP=2 LLM spans GPU 0 + GPU 1; Qwen3-TTS sits on GPU 1; optional Klein images sit on GPU 0.
LLM_GPU_DEVICE_0=0
LLM_GPU_DEVICE_1=1
TTS_GPU_DEVICE=1
IMAGE_GPU_DEVICE=0

# LLM TP=2 (vllm/vllm-openai:v0.34.0)
LLM_TP2_MODEL_ID=ukisai/Swift-1.5-Qwen3.8-27b-INT4
LLM_TP2_CHECKPOINT=81a28ee75eb1cd469f209813a368a79a7e3db3bc
# Rollback base model: RedHatAI/Qwen3.8-27B-INT4@71dface38d4cbfa34121f1d446d4a0fa1025f13c
LLM_TP2_GPU_MEMORY_UTILIZATION=0.80
# Empty leaves symmetric TP=2 KV cache auto-sized by vLLM.
LLM_TP2_KV_CACHE_BYTES=
LLM_TP2_KV_CACHE_DTYPE=
# 262144 verified at ~1.33x KV headroom on dual RTX 3090 with 0.6B TTS on GPU 1 (131072 fallback for tighter VRAM).
LLM_TP2_MAX_MODEL_LEN=262144
LLM_TP2_MAX_NUM_SEQS=8
LLM_TP2_MAX_NUM_BATCHED_TOKENS=8192
# Compilation mode 0 (default breakable CUDA graphs on Qwen3.5; vLLM 0.34.0 skips torch.compile mode=3 on Qwen3_5).
LLM_TP2_COMPILATION_MODE=0
LLM_TP2_CUDAGRAPH_CAPTURE_SIZES=1,2,4,8,16,32
LLM_TP2_ASYNC_SCHEDULING=1
LLM_TP2_ENABLE_PREFIX_CACHING=1
# Empty avoids deprecated flag warning on vLLM 0.34.0.
LLM_TP2_MAMBA_CACHE_MODE=
LLM_TP2_MAMBA_BLOCK_SIZE=4096
LLM_TP2_MM_ENCODER_TP_MODE=weights
# Speculative decoding: mtp (MTP=3) is the locked 262K winner; optional dspark/dflash below (needs shorter max_model_len).
LLM_TP2_SPECULATIVE_METHOD=mtp
LLM_TP2_ENABLE_MTP=1
LLM_TP2_MTP_NUM_SPECULATIVE_TOKENS=3
LLM_TP2_DRAFT_MODEL_ID=
LLM_TP2_DRAFT_CHECKPOINT=
LLM_TP2_DRAFT_TENSOR_PARALLEL_SIZE=2
LLM_TP2_NUM_SPECULATIVE_TOKENS=
# Optional external draft model example (e.g. DSpark-zh / DFlash):
# LLM_TP2_SPECULATIVE_METHOD=dspark
# LLM_TP2_DRAFT_MODEL_ID=ysober/qwen3.8-27b-dspark-zh
# LLM_TP2_DRAFT_CHECKPOINT=8b27d2618a67e6f05d09da04675f61ef460f3a5d
# LoRA disabled by default (B1); optional LoRA + alias example:
# LLM_TP2_ENABLE_LORA=1
# LLM_TP2_LORA_NAME=llm-zh-chat
# LLM_TP2_LORA_REPO_ID=Moeblack/Qwen3.8-27B-chinese-taste-sft-lora
# LLM_TP2_LORA_CHECKPOINT=6c8950c79ade177b6fcf74c6c921369f5715b225
# LLM_TP2_EXTRA_MODEL_ALIASES=llm-zh-chat=llm-zh-chat
LLM_TP2_ENABLE_LORA=0
LLM_TP2_LORA_NAME=
LLM_TP2_LORA_REPO_ID=
LLM_TP2_LORA_CHECKPOINT=
LLM_TP2_EXTRA_MODEL_ALIASES=
LLM_TP2_MAX_LORAS=2
LLM_TP2_MAX_LORA_RANK=32
LLM_TP2_REASONING_PARSER=qwen3
LLM_TP2_TOOL_CALL_PARSER=qwen3_coder
LLM_TP2_STRUCTURED_OUTPUTS_BACKEND=xgrammar
LLM_TP2_TOKEN_BUDGET=262144
# Default thinking budget injected by gateway when enable_thinking=true and caller omits thinking_token_budget.
LLM_DEFAULT_THINKING_TOKEN_BUDGET=16384
LLM_MAX_IMAGES_PER_REQUEST=8

# Optional LLM-only admission/deadline overrides for external orchestrators.
# Empty values inherit the corresponding Omni gateway values.
LLM_QUEUE_LIMIT=
LLM_QUEUE_TIMEOUT=
LLM_REQUEST_TIMEOUT=

# Zero-shot cloning TTS worker (GPU 1)
TTS_BACKEND=qwen3
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base
TTS_CHECKPOINT=5d83992436eae1d760afd27aff78a71d676296fc
# Optional Qwen3-TTS-12Hz-1.7B-Base upgrade (set LLM_TP2_GPU_MEMORY_UTILIZATION=0.72 on 24GB GPU 1):
# TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# TTS_CHECKPOINT=fd4b254389122332181a7c3db7f27e918eec64e3
# Optional CPU ONNX Genie-TTS adapter slot (0 MiB VRAM):
# TTS_BACKEND=genie
TTS_MAX_SEQ_LEN=2048
TTS_VOICE_CACHE_MAX=32
TTS_DEFAULT_REF_AUDIO_PATH=
TTS_DEFAULT_REF_TEXT=
OMNI_TTS_TIMEOUT=60

# CPU ASR worker (faster-whisper)
OMNI_ASR_MODEL=small
OMNI_ASR_COMPUTE_TYPE=int8
OMNI_ASR_MODEL_DATA=./data/models/asr
OMNI_ASR_MAX_CONCURRENCY=1
# OMNI_ASR_TIMEOUT=180

# CPU engineered full-duplex omni-engine (Silero VAD ONNX + omni-asr + llm-engine + omni-tts)
VAD_MODEL_ID=onnx-community/silero-vad
VAD_CHECKPOINT=e71cae966052b992a7eca6b17738916ce0eca4ec
OMNI_DUPLEX_MODEL_ID=omni-duplex-qwen38
OMNI_DUPLEX_CHECKPOINT=e71cae966052b992a7eca6b17738916ce0eca4ec
OMNI_DUPLEX_CAP=4
# Default LLM alias for full-duplex voice turns (set to an extra alias in LLM_TP2_EXTRA_MODEL_ALIASES if LoRA enabled).
OMNI_DUPLEX_LLM_MODEL=llm-default

# Optional --images layer (Klein 4B on IMAGE_GPU_DEVICE). Use separate private credentials.
OMNI_IMAGE_INTERNAL_TOKEN=
LLM_GPU_CONTROL_TOKEN=
OMNI_IMAGE_MIN_FREE_MIB=13312
OMNI_IMAGE_LLM_SLEEP_STRATEGY=auto
OMNI_IMAGE_PRELOAD_CPU=0
# Denoising steps per image. The distilled Klein checkpoint defaults to 4.
OMNI_IMAGE_STEPS=4

# --- Legacy rollback / single-GPU standalone compatibility (--target workstation-legacy / llm / omni) ---
OMNI_GPU_DEVICE=1
LLM_GPU_DEVICE=0
OMNI_WORKSTATION_CAP=2
OMNI_RELEASE_UNUSED_CUDA_CACHE=1
OMNI_PYTORCH_ALLOC_CONF=
LLM_MAX_NUM_SEQS=4
LLM_MAX_NUM_BATCHED_TOKENS=2048
LLM_TOKEN_BUDGET=262144
# Leave empty in .env for TP=2 auto KV sizing; uncomment only when pinning legacy 9 GiB KV on --target workstation-legacy.
# LLM_KV_CACHE_BYTES=9663676416

# Optional deploy/compose/media.yml. Set independent publishing/reading passwords.
MEDIAMTX_PUBLISH_PASSWORD=
MEDIAMTX_READ_PASSWORD=
MEDIAMTX_SIGNAL_BIND=127.0.0.1
MEDIAMTX_SIGNAL_PORT=8889
MEDIAMTX_ICE_BIND=127.0.0.1
MEDIAMTX_ICE_HOST=127.0.0.1

# Optional SSH connection details (not API authentication).
WORKSTATION_HOST=
WORKSTATION_USERNAME=
WORKSTATION_PASSWORD=
