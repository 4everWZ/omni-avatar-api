# 首次启动前复制为 .env，填写各自独立的随机凭据。
OMNI_GATEWAY_TOKEN=
OMNI_GATEWAY_ADMIN_TOKEN=
# 其它应用可使用独立凭据，格式为 JSON 对象，例 {"other-app":"<token>"}。
OMNI_GATEWAY_TOKENS=
OMNI_MODEL_DATA=./data/models
TUBER_OMNI_NETWORK=tuber-omni

# 默认只在宿主回环发布；同 Docker 网络应用可使用服务名直连。
OMNI_GATEWAY_BIND=127.0.0.1
OMNI_GATEWAY_PORT=8000
OMNI_BATCH_CAP=1
OMNI_LIVE_CAP=1
OMNI_QUEUE_TIMEOUT=5
OMNI_REQUEST_TIMEOUT=1200
OMNI_HEALTH_TIMEOUT=3
OMNI_REALTIME_IDLE_TIMEOUT=120

# Avatar overlay. Internal bearer differs from every application/admin token.
OMNI_AVATAR_INTERNAL_TOKEN=
# Host Docker bridge address, verify with: docker network inspect bridge
OMNI_AVATAR_BIND=172.17.0.1

# Optional media overlay. Set independent passwords only when using infra-media.compose.yml.
MEDIAMTX_PUBLISH_PASSWORD=
MEDIAMTX_READ_PASSWORD=
MEDIAMTX_SIGNAL_BIND=127.0.0.1
MEDIAMTX_SIGNAL_PORT=8889
MEDIAMTX_ICE_BIND=127.0.0.1
MEDIAMTX_ICE_HOST=127.0.0.1
