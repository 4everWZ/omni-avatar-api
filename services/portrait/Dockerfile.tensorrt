ARG PORTRAIT_BASE_IMAGE=omni-api-portrait:ditto
FROM ${PORTRAIT_BASE_IMAGE}
USER 0:0
RUN /opt/portrait-env/bin/python -m pip install --no-cache-dir --extra-index-url https://pypi.nvidia.com \
    tensorrt-cu13==11.4.0.106 onnxscript==0.7.2
COPY *.py /srv/portrait/
RUN install -d -o 10001 -g 10001 /run/omni-gpu
USER 10001:10001
